{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", "helpers:pinGitHubActionDigests"],
  "automerge": false,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "pre-commit": {
    "enabled": true
  },
  "dependencyDashboard": false,
  "prConcurrentLimit": 1,
  "platformAutomerge": true,
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "prPriority": -1
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "prPriority": 10
    },
    {
      "matchManagers": ["github-actions"],
      "automerge": true,
      "prPriority": 5
    },
    {
      "matchManagers": ["pre-commit"],
      "automerge": true,
      "prPriority": 4
    },
    {
      "matchManagers": ["gomod"],
      "automerge": true,
      "prPriority": 3
    },
    {
      "matchManagers": ["gomod"],
      "matchDepNames": ["go"],
      "matchDepTypes": ["golang"],
      "matchFileNames": ["go.mod"],
      "allowedVersions": "1.26.8",
      "automerge": false,
      "description": "keep the Go module version aligned with the pinned Go 1.26.8 toolchain"
    },
    {
      "matchManagers": ["mise"],
      "matchDatasources": ["github-tags"],
      "matchPackageNames": ["golang/go"],
      "matchFileNames": ["mise.toml"],
      "allowedVersions": "1.26.8",
      "automerge": false,
      "description": "keep the mise Go toolchain aligned with the Go module version"
    }
  ]
}
